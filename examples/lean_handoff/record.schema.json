{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "upg-strings quintic formal-verification pilot input v1",
  "description": "Proposed handoff format for one calibration example. Schema validity is not geometry or Lean certification. The standalone checker additionally requires Python exact integers, rejecting floats and booleans.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "example_id", "data_origin", "geometry_status", "formal_verification_status", "geometry", "provenance", "not_supplied"],
  "properties": {
    "schema": {"const": "upg-quintic-lean-pilot-v1"},
    "example_id": {"const": "fermat-quintic-p4"},
    "data_origin": {"const": "curated_textbook_not_ml_ranked"},
    "geometry_status": {"const": "representative"},
    "formal_verification_status": {"const": "not_performed"},
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complex_dimension", "ambient", "equation", "degree", "weights", "h11", "h21", "euler_char", "intersection_basis", "triple_intersection_H3", "ambient_fan"],
      "properties": {
        "complex_dimension": {"const": 3},
        "ambient": {"const": "P^4 over C"},
        "equation": {"const": "x0^5 + x1^5 + x2^5 + x3^5 + x4^5 = 0"},
        "degree": {"const": 5},
        "weights": {"const": [1, 1, 1, 1, 1]},
        "h11": {"type": "integer", "minimum": 1, "description": "Curated literature input, not computed by the checker."},
        "h21": {"type": "integer", "minimum": 0, "description": "Curated literature input, not computed by the checker."},
        "euler_char": {"type": "integer", "description": "Derived from declared Hodge numbers in the positive fixture; intentionally corrupted in the negative fixture."},
        "intersection_basis": {"const": "H = c1(O_P4(1)) restricted to X"},
        "triple_intersection_H3": {"type": "integer", "description": "Curated value 5. The checker compares it with the degree using the literature intersection formula."},
        "ambient_fan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lattice", "ray_matrix", "maximal_cones"],
          "properties": {
            "lattice": {"const": "N = Z^4"},
            "ray_matrix": {
              "type": "array", "minItems": 5, "maxItems": 5,
              "description": "Rows are ambient fan ray generators in N, NOT Newton-polytope vertices in M or a CYTools triangulation.",
              "items": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer"}}
            },
            "maximal_cones": {
              "description": "All four-ray subsets, using zero-based row indices; ambient P^4 fan combinatorics.",
              "const": [[0, 1, 2, 3], [0, 1, 2, 4], [0, 1, 3, 4], [0, 2, 3, 4], [1, 2, 3, 4]]
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_repository", "source_file", "source_json_pointer", "source_file_sha256", "source_record_file", "source_record_sha256", "reference", "reference_url"],
      "properties": {
        "source_repository": {"type": "string", "minLength": 1},
        "source_file": {"type": "string", "minLength": 1},
        "source_json_pointer": {"type": "string", "minLength": 1},
        "source_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_record_file": {"type": "string", "minLength": 1},
        "source_record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reference": {"type": "string", "minLength": 1},
        "reference_url": {"type": "string", "minLength": 1}
      }
    },
    "not_supplied": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
